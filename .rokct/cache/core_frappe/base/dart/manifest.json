{
  "name": "base_sdk",
  "version": "1.24.0",
  "home_page": "templates/routes/route_pages.dart",
  "_comment_app_assets": "app_assets registers these files in the host app's pubspec 'sdk-app-assets' block so they are bundled into the build. Only assets referenced by SDK code are kept here; legacy upstream-era driver/manager assets were removed (they live in paas_driver/paas_manager develop, and custodianship copies moved to delivery_sdk/merchants_sdk).",
  "app_assets": [
    "assets/images/app_logo.png",
    "assets/images/card.png",
    "assets/images/cardBg.png",
    "assets/images/delivery.png",
    "assets/images/door.png",
    "assets/images/fast.png",
    "assets/images/logo.png",
    "assets/images/notFound.png",
    "assets/images/order.png",
    "assets/images/save.png",
    "assets/images/set.png",
    "assets/images/splash.png",
    "assets/images/splash1.png",
    "assets/images/splash2.png",
    "assets/images/ui0.png",
    "assets/images/ui1.png",
    "assets/images/ui2.png",
    "assets/images/ui3.png",
    "assets/images/visa.png",
    "assets/lottie/girl_empty.json",
    "assets/lottie/not-found.json",
    "assets/lottie/not_found_page.json",
    "assets/lottie/notification_empty.json",
    "assets/lottie/processing.json",
    "assets/svgs/adress.svg",
    "assets/svgs/avatar.svg",
    "assets/svgs/brand_logo_rounded.svg",
    "assets/svgs/contact.svg",
    "assets/svgs/delivery.svg",
    "assets/svgs/delivery2.svg",
    "assets/svgs/delivery_time.svg",
    "assets/svgs/discount.svg",
    "assets/svgs/empty.svg",
    "assets/svgs/filter.svg",
    "assets/svgs/orderTime.svg",
    "assets/svgs/pickUpFrom.svg",
    "assets/svgs/star.svg",
    "assets/svgs/ticket.svg"
  ],
  "installs": [
    {
      "from": "templates/main.dart",
      "to": "lib/main.dart"
    },
    {
      "from": "templates/app_widget.dart",
      "to": "lib/presentation/app_widget.dart"
    },
    {
      "from": "templates/routes/app_router.dart",
      "to": "lib/presentation/routes/app_router.dart"
    },
    {
      "from": "templates/routes/route_pages.dart",
      "to": "lib/presentation/routes/route_pages.dart"
    },
    {
      "from": "templates/pubspec.yaml",
      "to": "pubspec.yaml"
    },
    {
      "from": "templates/analysis_options.yaml",
      "to": "analysis_options.yaml"
    },
    {
      "from": "templates/flutter_native_splash.yaml",
      "to": "flutter_native_splash.yaml"
    },
    {
      "from": "templates/android",
      "to": "android"
    },
    {
      "from": "templates/ios",
      "to": "ios"
    },
    {
      "from": "templates/assets",
      "to": "assets"
    },
    {
      "from": "templates/theme",
      "to": "lib/presentation/theme"
    }
  ],
  "routes": [
    {
      "path": "/",
      "page": "SplashRoute.page",
      "type": "MaterialRoute",
      "import": "package:${package}/presentation/routes/route_pages.dart"
    },
    {
      "path": "/no-connection",
      "page": "NoConnectionRoute.page",
      "type": "MaterialRoute",
      "import": "package:${package}/presentation/routes/route_pages.dart"
    },
    {
      "path": "/maintenance",
      "page": "MaintenanceRoute.page",
      "type": "MaterialRoute",
      "import": "package:${package}/presentation/routes/route_pages.dart"
    },
    {
      "path": "/ui-type",
      "page": "UiTypeRoute.page",
      "type": "MaterialRoute",
      "import": "package:${package}/presentation/routes/route_pages.dart"
    },
    {
      "path": "/generic-profile",
      "page": "GenericProfileRoute.page",
      "type": "MaterialRoute",
      "import": "package:${package}/presentation/routes/route_pages.dart"
    }
  ],
  "integrations": [],
  "app_routes": [
    {
      "method": "replaceSplashRoute",
      "body": "context.router.replace(SplashRoute());",
      "imports": [
        "import 'package:auto_route/auto_route.dart';",
        "import 'package:${package}/presentation/routes/app_router.dart';"
      ]
    },
    {
      "method": "replaceNoConnectionRoute",
      "body": "context.router.replace(NoConnectionRoute());",
      "imports": [
        "import 'package:auto_route/auto_route.dart';",
        "import 'package:${package}/presentation/routes/app_router.dart';"
      ]
    },
    {
      "method": "replaceMaintenanceRoute",
      "body": "context.router.replace(MaintenanceRoute());",
      "imports": [
        "import 'package:auto_route/auto_route.dart';",
        "import 'package:${package}/presentation/routes/app_router.dart';"
      ]
    },
    {
      "method": "replaceUiTypeRoute",
      "body": "context.router.replace(UiTypeRoute());",
      "imports": [
        "import 'package:auto_route/auto_route.dart';",
        "import 'package:${package}/presentation/routes/app_router.dart';"
      ]
    },
    {
      "method": "pushGenericProfileRoute",
      "body": "context.router.push(GenericProfileRoute());",
      "imports": [
        "import 'package:auto_route/auto_route.dart';",
        "import 'package:${package}/presentation/routes/app_router.dart';"
      ]
    }
  ],
  "_comment_app_type": "The tenant remote-config boot absorbed from the retired host lib/utils/app_initializer.dart files (manager migration M5, driver M4). Flavor-gated because the fetch is per-app ('app_type=Manager' / 'app_type=Driver'); other flavors declare their own entry with their own app_type string when they flip to fully generated shells. base_sdk has no lib/src/manager|driver role folders - declaring the personas only carries these hooks (role-stripping is a no-op for base).",
  "app_type": {
    "manager": {
      "boot_hooks": [
        {
          "id": "base-remote-config-boot",
          "order": 20,
          "body": "await RemoteConfigService.initialize(appType: 'Manager');",
          "imports": [
            "import 'package:base_sdk/src/services/remote_config_service.dart';"
          ]
        }
      ]
    },
    "driver": {
      "boot_hooks": [
        {
          "id": "base-remote-config-boot",
          "order": 20,
          "body": "await RemoteConfigService.initialize(appType: 'Driver');",
          "imports": [
            "import 'package:base_sdk/src/services/remote_config_service.dart';"
          ]
        }
      ]
    }
  }
}
