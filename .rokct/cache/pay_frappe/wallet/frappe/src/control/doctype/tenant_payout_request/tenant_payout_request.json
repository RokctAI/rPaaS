{
    "doctype": "DocType",
    "name": "Tenant Payout Request",
    "module": "{module_name}",
    "engine": "InnoDB",
    "permissions": [
        {
            "create": 1,
            "delete": 1,
            "email": 1,
            "export": 1,
            "print": 1,
            "read": 1,
            "report": 1,
            "role": "System Manager",
            "share": 1,
            "write": 1
        }
    ],
    "sort_field": "modified",
    "sort_order": "DESC",
    "fields": [
        {
            "fieldname": "customer",
            "fieldtype": "Link",
            "label": "Customer",
            "options": "Customer",
            "reqd": 1,
            "read_only": 1
        },
        {
            "fieldname": "amount",
            "fieldtype": "Currency",
            "label": "Amount",
            "reqd": 1
        },
        {
            "fieldname": "status",
            "fieldtype": "Select",
            "label": "Status",
            "options": "Pending\nApproved\nPaid\nRejected",
            "default": "Pending"
        },
        {
            "fieldname": "posting_date",
            "fieldtype": "Date",
            "label": "Posting Date",
            "default": "Today"
        },
        {
            "fieldname": "rejection_reason",
            "fieldtype": "Small Text",
            "label": "Rejection Reason",
            "depends_on": "eval:doc.status=='Rejected'"
        }
    ]
}
