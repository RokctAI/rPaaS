{
 "doctype": "DocType",
 "name": "Weather Watch Location",
 "engine": "InnoDB",
 "is_submittable": 0,
 "issingle": 0,
 "istable": 0,
 "module": "{module_name}",
 "autoname": "field:grid_key",
 "description": "One 0.25 degree grid cell under severe-weather evaluation. Self-registered by get_weather_warnings calls; admins may add or deactivate rows here. The list view doubles as the feature's health dashboard (sort by consecutive_failures). All datetimes are UTC.",
 "permissions": [
  {
   "create": 1,
   "delete": 1,
   "email": 1,
   "export": 1,
   "print": 1,
   "read": 1,
   "report": 1,
   "role": "System Manager",
   "share": 1,
   "write": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "grid_key",
   "fieldtype": "Data",
   "label": "Grid Key",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Grid-rounded \"lat,lng\" at 0.25 degree resolution - the unique evaluation key"
  },
  {
   "fieldname": "label",
   "fieldtype": "Data",
   "label": "Label",
   "description": "Human place name used in friendly copy (falls back to 'your area')"
  },
  {
   "fieldname": "latitude",
   "fieldtype": "Float",
   "label": "Latitude",
   "precision": "8",
   "reqd": 1
  },
  {
   "fieldname": "longitude",
   "fieldtype": "Float",
   "label": "Longitude",
   "precision": "8",
   "reqd": 1
  },
  {
   "fieldname": "active",
   "fieldtype": "Check",
   "label": "Active",
   "default": "1",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "last_requested_at",
   "fieldtype": "Datetime",
   "label": "Last Requested At (UTC)",
   "read_only": 1
  },
  {
   "fieldname": "last_evaluated_at",
   "fieldtype": "Datetime",
   "label": "Last Evaluated At (UTC)",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "last_evaluated_horizon",
   "fieldtype": "Datetime",
   "label": "Last Evaluated Data Horizon (UTC)",
   "read_only": 1,
   "description": "Data-source horizon of the last evaluation - the hourly job skips this location until the source advances past it"
  },
  {
   "fieldname": "last_error",
   "fieldtype": "Small Text",
   "label": "Last Error",
   "read_only": 1
  },
  {
   "fieldname": "consecutive_failures",
   "fieldtype": "Int",
   "label": "Consecutive Failures",
   "read_only": 1,
   "in_list_view": 1,
   "default": "0"
  }
 ]
}
