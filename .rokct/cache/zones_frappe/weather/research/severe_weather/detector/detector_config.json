        {"name": "moist_plume", "feature": "tcwv_anom_7d", "direction": "above", "on": 5.0, "off": 2.0, "weight": 0.25, "persistence_h": 2}
      ],
      "required": [],
      "groups": [],
      "severity_on": {"watch": 0.35, "warning": 0.55, "severe": 0.80},
