                        "{app_name}.tender.control.compliance.deadline_watch.sweep_bid_deadlines"
                    ],
                    "weekly": [
                        "{app_name}.tender.control.compliance.artifact_expiry.sweep_compliance_artifacts",
                        "{app_name}.tender.control.quotation_link.ensure_quotation_tender_field",
                        "{app_name}.tender.control.drift_report.run_suitability_drift_report"
                    ]
                },
                "after_install": [
                    "{app_name}.tender.control.quotation_link.ensure_quotation_tender_field"
                ],
                "doc_events": {
                    "Tender Bid": {
                        "validate": "{app_name}.tender.control.compliance.computed_fields.update_computed_fields"
                    },
                    "Quotation": {
                        "validate": "{app_name}.tender.control.quotation_link.sync_quotation_link"
                    }
                },
